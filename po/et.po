#: src/main.c:164
msgid "Drop all elevated privileges"
msgstr "Loobu kõigist saadud õigustest"

#: src/main.c:188
msgid "Click the icon to drop all elevated privileges"
msgstr "Kõigist saadud õigustest loobumiseks klõpsa ikoonil"

#: src/polkitmateauthenticationdialog.c:276
msgid "Select user..."
msgstr "Vali vasutaja…"

#: src/polkitmateauthenticationdialog.c:310
#, c-format
msgid "%s (%s)"
msgstr "%s (%s)"

#: src/polkitmateauthenticationdialog.c:663
msgid "_Cancel"
msgstr "_Katkesta"

#: src/polkitmateauthenticationdialog.c:668
msgid "_Authenticate"
msgstr "_Autendi"

#: src/polkitmateauthenticationdialog.c:709
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication as one of the users below is required to perform this action."
msgstr ""
"Rakendus püüab läbi viia kasutajaõigusi nõudvat tegevust. Selle jaoks on "
"tarvis läbi viia autentimine ühena allpool loetletud kasutajatest."

#: src/polkitmateauthenticationdialog.c:717
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication is required to perform this action."
msgstr ""
"Rakendus püüab läbi viia kasutajaõigusi nõudvat tegevust. Selle jaoks on "
"tarvis läbi viia autentimine."

#: src/polkitmateauthenticationdialog.c:723
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication as the super user is required to perform this action."
msgstr ""
"Rakendus püüab läbi viia kasutajaõigusi nõudvat tegevust. Selle jaoks on "
"tarvis läbi viia ülemkasutaja autentimine."

#: src/polkitmateauthenticationdialog.c:759 src/polkitmateauthenticator.c:301
msgid "_Password:"
msgstr "_Salasõna:"

#: src/polkitmateauthenticationdialog.c:777
msgid "<small><b>_Details</b></small>"
msgstr "<small><b>Ü_ksikasjad</b></small>"

#: src/polkitmateauthenticationdialog.c:835
msgid "<small><b>Action:</b></small>"
msgstr "<small><b>Tegevus:</b></small>"

#: src/polkitmateauthenticationdialog.c:838
#, c-format
msgid "Click to edit %s"
msgstr "Vajuta %s muutmiseks"

#: src/polkitmateauthenticationdialog.c:855
msgid "<small><b>Vendor:</b></small>"
msgstr "<small><b>Tootja:</b></small>"

#: src/polkitmateauthenticationdialog.c:857
#, c-format
msgid "Click to open %s"
msgstr "Vajuta %s avamiseks"

#: src/polkitmateauthenticationdialog.c:1014
msgid "Authenticate"
msgstr "Autentimine"

#: src/polkitmateauthenticator.c:297
#, c-format
msgid "_Password for %s:"
msgstr "Kasutaja %s _salasõna:"

#: src/polkitmateauthenticator.c:460
msgid "Your authentication attempt was unsuccessful. Please try again."
msgstr "Sinu autentimiskatse ei õnnestunud. Palun proovi uuesti."

#: src/polkitmatelistener.c:164
msgid "Authentication dialog was dismissed by the user"
msgstr "Kasutaja sulges autentimisvaate"

#: src/polkit-mate-authentication-agent-1.desktop.in.in:3
